# Configurações do Supabase
SUPABASE_URL=https://uflheoknbopcgmzyjbft.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configurações do Gemini
API_KEY=

# Segurança Webhook Inbox
INBOX_API_KEY=

# Configurações Asaas
ASAAS_API_KEY=
ASAAS_API_URL=https://www.asaas.com/api/v3

# Configurações do WhatsApp Business / Gateway API (Oficial)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Configuração Opcional dos Contribuintes (Microserviço VPS)
# Para apontar o Proxy diretamente para o Contributors API hospedado no Coolify:
CONTRIBUTORS_API_URL=http://contributors-api:3010
# Ou caso queira que o processo filho local conecte ao Postgres:
DATABASE_URL=

# Configurações de Backup PostgreSQL Criptografado (Etapa 2 e Etapa 3)
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_FILES=14
BACKUP_SCHEDULE_ENABLED=true

# Armazenamento Externo S3 / Cloudflare R2 / DigitalOcean Spaces / B2 (Etapa 3)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PREFIX=backups/
S3_FORCE_PATH_STYLE=false
